# Web App (Next.js)
# Copy to web/.env.local for local development
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CURRENCY=INR

# Local / Migration Database Connections (NEVER commit real passwords)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Supabase Edge Function Secrets (set via `supabase secrets set GEMINI_API_KEY=...`, never expose in NEXT_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key

# Android Local Build Secrets (set in untracked android/local.properties or android/keystore.properties or CI env)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
SPENDWISE_KEYSTORE_FILE=path-to-release-keystore.jks
SPENDWISE_KEYSTORE_PASSWORD=your-keystore-password
SPENDWISE_KEY_ALIAS=your-key-alias
SPENDWISE_KEY_PASSWORD=your-key-password
